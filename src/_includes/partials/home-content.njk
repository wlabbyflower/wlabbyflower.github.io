{% from "components/icon.njk" import icon with context %}
{% set activeLocale = locale or 'zh' %}
{% set t = i18n.translations[activeLocale] %}
{% if activeLocale == 'zh' %}
  {% set visibleGuides = guides %}
{% else %}
  {% set visibleGuides = localizedGuides | where('locale', activeLocale) %}
{% endif %}
{% set peppapig = visibleGuides | guideById('peppapig-deploy') %}
{% set lan = visibleGuides | guideById('lan-sharing') %}

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content">
    <p class="eyebrow">{{ t.homeEyebrow }}</p>
    <h1 id="hero-title">{{ t.homeTitle | safe }}</h1>
    <p class="hero__summary">{{ t.homeSummary }}</p>
    <div class="hero__actions">
      <a class="button button--primary" href="{{ peppapig.url | url }}">{{ t.homePrimary }} {{ icon('arrow-right') }}</a>
      <a class="button button--secondary" href="{{ '/guides/' | localizePath(activeLocale) | url }}">{{ t.homeCrossPlatform }}</a>
      <button class="button button--glass" type="button" data-search-open>{{ icon('search') }} {{ t.homeSearch }}</button>
    </div>
  </div>
</section>

<section class="path-section section-wrap" id="start">
  <div class="section-heading">
    <p class="eyebrow">{{ t.pathEyebrow }}</p>
    <h2>{{ t.pathTitle }}</h2>
    <p>{{ t.pathDescription }}</p>
  </div>

  <div class="path-list">
    <a href="{{ '/guides/cat/' | localizePath(activeLocale) | url }}" class="path-item">
      <span class="path-item__number">01</span>
      <span><strong>{{ t.pathDeploy }}</strong><small>{{ t.pathDeploySmall }}</small></span>
      {{ icon('arrow-right') }}
    </a>
    <a href="{{ lan.url | url }}" class="path-item">
      <span class="path-item__number">02</span>
      <span><strong>{{ t.pathLan }}</strong><small>{{ t.pathLanSmall }}</small></span>
      {{ icon('arrow-right') }}
    </a>
    <a href="{{ '/guides/' | localizePath(activeLocale) | url }}" class="path-item">
      <span class="path-item__number">03</span>
      <span><strong>{{ t.pathClients }}</strong><small>{{ t.pathClientsSmall }}</small></span>
      {{ icon('arrow-right') }}
    </a>
  </div>
</section>

<section class="client-section section-wrap" id="clients">
  <div class="section-heading section-heading--row">
    <div>
      <p class="eyebrow">{{ t.clientsEyebrow }}</p>
      <h2>{{ t.clientsTitle }}</h2>
    </div>
    <a class="text-link" href="{{ '/guides/' | localizePath(activeLocale) | url }}">{{ t.viewAll }} {{ icon('arrow-right') }}</a>
  </div>

  <div class="client-list">
    {% for item in visibleGuides %}
      {% if item.home %}
        <a href="{{ item.url | url }}" class="client-row">
          <span class="client-row__platform">{{ item.platform }}</span>
          <span class="client-row__title">{{ item.shortTitle }}</span>
          <span class="client-row__summary">{{ item.summary }}</span>
          {{ icon('chevron-right') }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

<section class="final-section section-wrap">
  <div class="final-section__inner">
    <div>
      <p class="eyebrow">{{ t.indexEyebrow }}</p>
      <h2>{{ t.indexTitle }}</h2>
    </div>
    <a class="button button--primary" href="{{ '/guides/' | localizePath(activeLocale) | url }}">{{ t.openLibrary }} {{ icon('arrow-right') }}</a>
  </div>
</section>
