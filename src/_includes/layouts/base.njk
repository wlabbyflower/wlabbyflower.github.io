{% from "components/icon.njk" import icon with context %}
{% set activeLocale = guide.locale or guideView.locale or locale or 'zh' %}
{% set currentLocale = locales | find('key', activeLocale) %}
{% set targetLocaleKey = 'en' if activeLocale == 'zh' else 'zh' %}
{% set targetLocale = locales | find('key', targetLocaleKey) %}
{% set t = i18n.translations[activeLocale] %}
<!DOCTYPE html>
<html lang="{{ currentLocale.code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f5f7">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="{{ description or t.siteDescription }}">
    <title>{% if title and title != t.siteTitle %}{{ title }} · {% endif %}{{ t.siteTitle }}</title>
    <script src="{{ '/assets/vendor/suncalc.js' | url }}"></script>
    <script>
      (function () {
        var root = document.documentElement;
        var storageKey = "peppapig-theme-mode";
        var latitude = 39.9042;
        var longitude = 116.4074;
        var timer = 0;

        root.classList.add("js");

        function getStoredMode() {
          try {
            localStorage.removeItem("peppapig-theme");
            var stored = localStorage.getItem(storageKey);
            return stored === "light" || stored === "dark" ? stored : "auto";
          } catch (error) {
            return "auto";
          }
        }

        function beijingNoon(date, dayOffset) {
          var values = {};
          new Intl.DateTimeFormat("en-US", {
            timeZone: "Asia/Shanghai",
            year: "numeric",
            month: "2-digit",
            day: "2-digit"
          }).formatToParts(date).forEach(function (part) {
            if (part.type !== "literal") values[part.type] = Number(part.value);
          });
          return new Date(Date.UTC(values.year, values.month - 1, values.day + (dayOffset || 0), 4));
        }

        function solarWindow(date, dayOffset) {
          if (!window.SunCalc) return null;
          return window.SunCalc.getTimes(beijingNoon(date, dayOffset), latitude, longitude);
        }

        function automaticTheme(date) {
          var times = solarWindow(date, 0);
          if (times && isFinite(times.sunrise) && isFinite(times.sunset)) {
            return date >= times.sunrise && date < times.sunset ? "light" : "dark";
          }
          var beijingHour = Number(new Intl.DateTimeFormat("en-US", {
            timeZone: "Asia/Shanghai",
            hour: "2-digit",
            hourCycle: "h23"
          }).format(date));
          return beijingHour >= 6 && beijingHour < 18 ? "light" : "dark";
        }

        function applyTheme(mode) {
          var effectiveTheme = mode === "auto" ? automaticTheme(new Date()) : mode;
          root.dataset.themeMode = mode;
          root.dataset.theme = effectiveTheme;
          document.querySelector('meta[name="theme-color"]').content = effectiveTheme === "dark" ? "#000000" : "#f5f5f7";
          window.dispatchEvent(new CustomEvent("peppapigthemechange", {
            detail: { mode: mode, theme: effectiveTheme }
          }));
          return effectiveTheme;
        }

        function scheduleSolarChange() {
          window.clearTimeout(timer);
          if (root.dataset.themeMode !== "auto") return;
          var now = new Date();
          var today = solarWindow(now, 0);
          var tomorrow = solarWindow(now, 1);
          if (!today || !tomorrow) return;
          var nextBoundary = now < today.sunrise ? today.sunrise : now < today.sunset ? today.sunset : tomorrow.sunrise;
          timer = window.setTimeout(function () {
            applyTheme("auto");
            scheduleSolarChange();
          }, Math.max(nextBoundary - now + 1000, 1000));
        }

        function setMode(mode) {
          var nextMode = mode === "light" || mode === "dark" ? mode : "auto";
          try {
            localStorage.setItem(storageKey, nextMode);
          } catch (error) {}
          applyTheme(nextMode);
          scheduleSolarChange();
        }

        window.peppaPigTheme = {
          apply: applyTheme,
          setMode: setMode,
          schedule: scheduleSolarChange
        };
        applyTheme(getStoredMode());
        scheduleSolarChange();
      })();
    </script>
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  </head>
  <body
    class="{{ bodyClass or '' }}"
    data-base-url="{{ '/' | url }}"
    data-search-url="{{ '/search-index.json' | localizePath(activeLocale) | url }}"
    data-locale="{{ activeLocale }}"
    data-i18n="{{ t | json | escape }}"
  >
    <a class="skip-link" href="#main-content">{{ t.skipToContent }}</a>

    <header class="site-header" data-site-header>
      <div class="site-header__inner">
        <a class="brand" href="{{ '/' | localizePath(activeLocale) | url }}" aria-label="{{ t.siteTitle }} {{ t.navHome }}">
          <img class="brand__mark" src="{{ '/assets/images/icon.jpg' | url }}" alt="" width="28" height="28">
          <span class="brand__text">{{ t.shortTitle }}</span>
        </a>

        <nav class="desktop-nav" aria-label="{{ t.navMenu }}">
          <a href="{{ '/' | localizePath(activeLocale) | url }}"{% if page.url == ('/' | localizePath(activeLocale)) %} aria-current="page"{% endif %}>{{ t.navHome }}</a>
          <a href="{{ '/guides/' | localizePath(activeLocale) | url }}"{% if page.url and page.url.startsWith('/guides/' | localizePath(activeLocale)) %} aria-current="page"{% endif %}>{{ t.navGuides }}</a>
          <a href="{{ site.sourceUrl }}" target="_blank" rel="noreferrer">{{ t.navSource }} {{ icon('external-link', 'icon--small') }}</a>
        </nav>

        <div class="header-actions">
          <button class="header-button header-button--search" type="button" data-search-open>
            {{ icon('search') }}
            <span>{{ t.navSearch }}</span>
            <kbd>⌘ K</kbd>
          </button>
          <a class="language-toggle" href="{{ page.url | switchLocalePath(targetLocaleKey) | url }}" hreflang="{{ targetLocale.code }}" aria-label="{{ t.languageSwitch }}">
            {{ t.languageSwitch }}
          </a>
          <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="{{ t.themeAuto }}" title="{{ t.themeAuto }}">
            {{ icon('sun-moon', 'theme-toggle__auto') }}
            {{ icon('sun', 'theme-toggle__light') }}
            {{ icon('moon', 'theme-toggle__dark') }}
          </button>
          <button class="icon-button menu-toggle" type="button" data-menu-open aria-label="{{ t.openMenu }}" title="{{ t.openMenu }}">
            {{ icon('menu') }}
          </button>
        </div>
      </div>
    </header>

    <div class="mobile-menu" data-mobile-menu inert>
      <button class="mobile-menu__backdrop" type="button" data-menu-close tabindex="-1" aria-label="{{ t.closeMenu }}"></button>
      <nav class="mobile-menu__panel" aria-label="{{ t.mobileChapterNavigation }}">
        <div class="mobile-menu__header">
          <span>{{ t.navMenu }}</span>
          <button class="icon-button" type="button" data-menu-close aria-label="{{ t.closeMenu }}" title="{{ t.closeMenu }}">{{ icon('x') }}</button>
        </div>
        <a href="{{ '/' | localizePath(activeLocale) | url }}">{{ t.navHome }} {{ icon('chevron-right') }}</a>
        <a href="{{ '/guides/' | localizePath(activeLocale) | url }}">{{ t.navAllGuides }} {{ icon('chevron-right') }}</a>
        <a href="{{ page.url | switchLocalePath(targetLocaleKey) | url }}" hreflang="{{ targetLocale.code }}">{{ t.languageSwitch }} {{ icon('chevron-right') }}</a>
        <a href="{{ site.sourceUrl }}" target="_blank" rel="noreferrer">{{ t.navGithubSource }} {{ icon('external-link') }}</a>
      </nav>
    </div>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <a class="brand brand--footer" href="{{ '/' | localizePath(activeLocale) | url }}">
            <img class="brand__mark" src="{{ '/assets/images/icon.jpg' | url }}" alt="" width="28" height="28">
            <span class="brand__text">{{ t.shortTitle }}</span>
          </a>
          <p>{{ t.footerDescription }}</p>
        </div>
        <div class="footer-links">
          <a href="{{ '/guides/' | localizePath(activeLocale) | url }}">{{ t.footerBrowse }}</a>
          <a href="{{ site.sourceUrl }}" target="_blank" rel="noreferrer">{{ t.footerContribute }}</a>
        </div>
      </div>
    </footer>

    <dialog class="search-dialog" data-search-dialog>
      <div class="search-dialog__surface">
        <div class="search-dialog__bar">
          {{ icon('search') }}
          <label class="sr-only" for="site-search">{{ t.searchLabel }}</label>
          <input id="site-search" type="search" autocomplete="off" placeholder="{{ t.searchPlaceholder }}" data-search-input>
          <button class="icon-button" type="button" data-search-close aria-label="{{ t.searchClose }}" title="{{ t.searchClose }}">{{ icon('x') }}</button>
        </div>
        <div class="search-dialog__status" data-search-status>{{ t.searchStart }}</div>
        <div class="search-results" data-search-results></div>
      </div>
    </dialog>

    <dialog class="image-dialog" data-image-dialog>
      <button class="icon-button image-dialog__close" type="button" data-image-close aria-label="{{ t.closeImage }}" title="{{ t.closeImage }}">{{ icon('x') }}</button>
      <img data-image-preview alt="">
    </dialog>

    <script src="{{ '/assets/js/main.js' | url }}" defer></script>
  </body>
</html>
