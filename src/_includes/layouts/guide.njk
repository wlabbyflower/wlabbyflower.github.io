---
layout: layouts/base.njk
bodyClass: guide-page
---
{% from "components/icon.njk" import icon with context %}
{% set activeLocale = guide.locale or locale or 'zh' %}
{% set t = i18n.translations[activeLocale] %}
{% set visibleGuides = localizedGuides | where('locale', activeLocale) %}
<div class="reading-progress" data-reading-progress></div>

<div class="guide-shell">
  <aside class="guide-sidebar" aria-label="{{ t.guideNavigation }}">
    <a class="guide-sidebar__back" href="{{ '/guides/' | localizePath(activeLocale) | url }}">{{ icon('chevron-left') }} {{ t.allGuides }}</a>
    {% set currentSection = '' %}
    <nav aria-label="{{ t.allGuides }}">
      {% for item in visibleGuides %}
        {% if not item.hidden %}
          {% if item.sectionLabel != currentSection %}
            {% set currentSection = item.sectionLabel %}
            <p class="guide-sidebar__label">{{ currentSection }}</p>
          {% endif %}
          <a href="{{ item.url | url }}"{% if item.id == guide.id %} aria-current="page"{% endif %}>{{ item.shortTitle }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  </aside>

  <article class="guide-article" data-guide-article>
    <header class="article-header">
      <nav class="breadcrumb" aria-label="{{ t.breadcrumbGuides }}">
        <a href="{{ '/guides/' | localizePath(activeLocale) | url }}">{{ t.breadcrumbGuides }}</a>
        <span>/</span>
        <span>{{ guide.sectionLabel }}</span>
      </nav>
      <div class="article-meta">
        <span>{{ guide.platform }}</span>
        <span>{{ guide.sectionLabel }}</span>
      </div>
      <h1>{{ guide.title }}</h1>
      <p>{{ guide.summary }}</p>

      {% if guide.resources %}
        <nav class="article-resources" aria-label="{{ t.relatedDownloads }}">
          {% for resource in guide.resources %}
            <a href="{{ resource.url | url }}" download>
              {{ icon('download') }}
              <span>{{ resource.label }}</span>
              <small>{{ resource.type }}</small>
            </a>
          {% endfor %}
        </nav>
      {% endif %}
    </header>

    <details class="mobile-toc">
      <summary>{{ icon('book-open') }} {{ t.toc }}</summary>
      <nav data-toc-mobile aria-label="{{ t.mobileChapterNavigation }}"></nav>
    </details>

    <div class="article-body" data-article-body>
      {% if guide.stripLeadingHeading %}
        {{ content | stripLeadingHeading | safe }}
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>

    <nav class="article-pagination" aria-label="相邻指南">
      {% if guide.previous %}
        <a href="{{ guide.previous.url | url }}" class="article-pagination__previous">
          {{ icon('chevron-left') }}
          <span><small>{{ t.previous }}</small>{{ guide.previous.title }}</span>
        </a>
      {% else %}<span></span>{% endif %}
      {% if guide.next %}
        <a href="{{ guide.next.url | url }}" class="article-pagination__next">
          <span><small>{{ t.next }}</small>{{ guide.next.title }}</span>
          {{ icon('chevron-right') }}
        </a>
      {% endif %}
    </nav>
  </article>

  <aside class="guide-toc" aria-label="{{ t.toc }}">
    <p>{{ t.toc }}</p>
    <nav data-toc aria-label="{{ t.tocAria }}"></nav>
  </aside>
</div>
