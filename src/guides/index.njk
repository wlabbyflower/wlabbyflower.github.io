---
pagination:
  data: localizedGuideViews
  size: 1
  alias: guideView
layout: layouts/library.njk
bodyClass: library-page
permalink: "{{ guideView.url }}"
locale: "{{ guideView.locale }}"
eleventyComputed:
  title: "{{ guideView.title }}"
  description: "{{ guideView.description }}"
---
{% from "components/icon.njk" import icon with context %}
{% set activeLocale = guideView.locale or 'zh' %}
{% set t = i18n.translations[activeLocale] %}
{% set visibleGuides = localizedGuides | where('locale', activeLocale) %}
{% set visibleResources = localizedResources | where('locale', activeLocale) %}
{% macro guideRow(item) %}
  <a class="library-row" href="{{ item.url | url }}">
    <span class="library-row__index">{% if item.displayIndex < 10 %}0{% endif %}{{ item.displayIndex }}</span>
    <span class="library-row__main">
      <span class="library-row__title">{{ item.title }}</span>
      <span class="library-row__summary">{{ item.summary }}</span>
    </span>
    <span class="library-row__platform">{{ item.platform }}</span>
    {{ icon('chevron-right') }}
  </a>
{% endmacro %}

<section class="library-hero section-wrap">
  <nav class="breadcrumb" aria-label="{{ t.breadcrumbGuides }}"><a href="{{ '/' | localizePath(activeLocale) | url }}">{{ t.breadcrumbHome }}</a><span>/</span><span>{{ t.breadcrumbGuides }}</span></nav>
  <p class="eyebrow">{{ t.libraryEyebrow }}</p>
  <h1>{{ guideView.heading }}</h1>
  <p>{{ guideView.description }}</p>

  <div class="library-toolbar">
    <nav class="segmented-control" aria-label="{{ t.categoryPage }}">
      {% for view in localizedGuideViews %}
        {% if view.locale == activeLocale %}
        <a href="{{ view.url | url }}"{% if view.key == guideView.key %} class="is-active" aria-current="page"{% endif %}>{{ view.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <button class="button button--secondary" type="button" data-search-open>{{ icon('search') }} {{ t.searchBody }}</button>
  </div>
</section>

<section class="library-content section-wrap">
  {% if guideView.key == 'all' %}
    <h2 class="library-section-title">{{ t.deploySection }}</h2>
    {% for item in visibleGuides %}
      {% if not item.hidden and (item.id == 'peppapig-deploy' or item.id == 'clash-deploy') %}{{ guideRow(item) }}{% endif %}
    {% endfor %}

    <h2 class="library-section-title">{{ t.clientsSection }}</h2>
    {% for item in visibleGuides %}
      {% if not item.hidden and item.id != 'peppapig-deploy' and item.id != 'clash-deploy' %}{{ guideRow(item) }}{% endif %}
    {% endfor %}

    <h2 class="library-section-title">{{ t.resourcesSection }}</h2>
    {% for resource in visibleResources %}
      <a class="library-row" href="{{ resource.url | url }}">
        <span class="library-row__index">MP4</span>
        <span class="library-row__main">
          <span class="library-row__title">{{ resource.title }}</span>
          <span class="library-row__summary">{{ resource.summary }}</span>
        </span>
        <span class="library-row__platform">{{ resource.platform }}</span>
        {{ icon('download') }}
      </a>
    {% endfor %}
  {% elif guideView.key == 'cat' %}
    <h2 class="library-section-title">{{ t.deploySection }}</h2>
    {% for item in visibleGuides %}
      {% if not item.hidden and (item.id == 'peppapig-deploy' or item.id == 'clash-deploy') %}{{ guideRow(item) }}{% endif %}
    {% endfor %}
  {% elif guideView.key == 'cross-platform' %}
    <h2 class="library-section-title">
      {{ t.crossPlatformSection }}
      <small class="library-section-subtitle">{{ t.crossPlatformPlatforms }}</small>
    </h2>
    {% for item in visibleGuides %}
      {% if not item.hidden and item.sourcePlatform == '跨平台' %}{{ guideRow(item) }}{% endif %}
    {% endfor %}
    <h2 class="library-section-title library-section-title--sub">{{ t.resourcesSection }}</h2>
    {% for resource in visibleResources %}
      <a class="library-row" href="{{ resource.url | url }}">
        <span class="library-row__index">MP4</span>
        <span class="library-row__main">
          <span class="library-row__title">{{ resource.title }}</span>
          <span class="library-row__summary">{{ resource.summary }}</span>
        </span>
        <span class="library-row__platform">{{ resource.platform }}</span>
        {{ icon('download') }}
      </a>
    {% endfor %}
  {% else %}
    <h2 class="library-section-title">{{ guideView.label }} {{ t.clientsSection }}</h2>
    {% for item in visibleGuides %}
      {% if not item.hidden and item.sourcePlatform == guideView.sourcePlatform %}{{ guideRow(item) }}{% endif %}
    {% endfor %}
  {% endif %}
</section>
