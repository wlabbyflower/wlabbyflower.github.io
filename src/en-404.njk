---
layout: layouts/base.njk
title: Page not found
permalink: /en/404.html
eleventyExcludeFromCollections: true
locale: en
---
{% from "components/icon.njk" import icon with context %}
{% set t = i18n.translations[locale] %}
<section class="not-found section-wrap">
  <p class="eyebrow">404</p>
  <h1>{{ t.notFoundTitle }}</h1>
  <p>{{ t.notFoundDescription }}</p>
  <div>
    <a class="button button--primary" href="{{ '/guides/' | localizePath(locale) | url }}">{{ t.browseGuides }} {{ icon('arrow-right') }}</a>
    <button class="button button--secondary" type="button" data-search-open>{{ icon('search') }} {{ t.navSearch }}</button>
  </div>
</section>
